{
	"luci-app-aiassist": {
		"description": "Grant access to LuCI AI Assistant procedures",
		"read": {
			"ubus": {
				"aiassist": [
					"getInfo",
					"getSettings",
					"listSessions",
					"getSession",
					"pollJob",
					"getSystemInfo",
					"listSnapshots",
					"snapshotDiff",
					"getSnapshot",
					"listMtd"
				]
			}
		},
		"write": {
			"ubus": {
				"aiassist": [
					"createSession",
					"deleteSession",
					"renameSession",
					"sendMessage",
					"stopJob",
					"compressContext",
					"rollback",
					"createSnapshot",
					"backupMtd",
					"testConnection",
					"updateSettings",
					"setApiKey",
					"clearApiKey"
				]
			},
			"file": {
				"/etc/aiassist/*": [ "write" ]
			}
		}
	}
}
